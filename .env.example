# ============================================================
# .env.example — safe to commit, contains NO real secrets
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local
# ============================================================

# ── Prisma Postgres — two URLs, two purposes ──────────────────
#
# DATABASE_URL      → prisma+postgres:// Accelerate URL
#                     Used by the app at runtime for all queries
#                     Get from: console.prisma.io → your project → "App connection"
#
# DATABASE_DIRECT_URL → postgres:// direct connection
#                       Used only by the Prisma CLI (migrate, generate)
#                       Get from: console.prisma.io → your project → "Direct connection"
#
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_API_KEY"
DATABASE_DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET="your-long-random-secret-here"

# OpenAI API key — get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# App URL
NEXTAUTH_URL="http://localhost:3000"

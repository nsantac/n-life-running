# ============================================================
# .env.example — safe to commit, contains NO real secrets
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local
# ============================================================

# Database (Prisma Postgres)
# Run: npx create-db  — this sets DATABASE_URL automatically
# Or get from: https://console.prisma.io → your project → Connection string
# Format: prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_KEY
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_API_KEY_HERE"

# Auth.js secret — generate with: npx auth secret
# Must be a long random string, keep it private
AUTH_SECRET="your-long-random-secret-here"

# OpenAI API key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# App URL (used by Auth.js for callbacks)
NEXTAUTH_URL="http://localhost:3000"
# Production: set this in Vercel env vars
# NEXTAUTH_URL="https://your-app.vercel.app"

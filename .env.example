# ============================================================
# .env.example — safe to commit, contains NO real secrets
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local
# ============================================================

# Database (Neon PostgreSQL)
# Get from: https://neon.tech → your project → Connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Auth.js secret — generate with: npx auth secret
# Must be a long random string
AUTH_SECRET="your-long-random-secret-here"

# OpenAI API key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# App URL (used by Auth.js for callbacks)
# Local development:
NEXTAUTH_URL="http://localhost:3000"
# Production (set this in Vercel env vars, not here):
# NEXTAUTH_URL="https://your-app.vercel.app"
